<% content_for :title, "Bap" %>
<% content_for :main_class, "min-h-dvh flex items-center justify-center px-4 py-8" %>

<%# Full-page photo behind everything; the dark overlay keeps the heading readable. %>
<div data-home-background aria-hidden="true"
     class="fixed inset-0 -z-10 bg-cover bg-center bg-yellow-400"
     style="background-image: url('<%= image_path("home-corn.webp") %>')">
  <div class="absolute inset-0 bg-black/35"></div>
</div>

<div class="w-full max-w-3xl text-center">
  <h1 lang="vi" class="font-bold text-4xl sm:text-6xl lg:text-7xl leading-tight text-balance text-center text-white drop-shadow-[0_2px_8px_rgb(0_0_0/0.6)]">Tập Đều Như Bắp</h1>

  <div class="mt-8 flex flex-col items-center gap-4">
    <%= render "shared/flash", css: "shadow-md" %>

    <% if authenticated? %>
      <%= link_to "Go to dashboard", dashboard_path,
            class: "inline-flex h-10 items-center rounded-full px-5 bg-white text-[#1F1F1F] border border-[#747775] text-sm font-medium shadow-md hover:bg-gray-50" %>
    <% else %>
      <%# Styled to Google's "Sign in with Google" branding guidelines (light theme).
          Turbo is off: its fetch can't follow the redirect to accounts.google.com. %>
      <%= button_to "/auth/google_oauth2", method: :post, form: { data: { turbo: false } },
            class: "inline-flex h-10 w-64 items-center justify-center gap-2.5 rounded-full pl-3 pr-4 bg-white text-[#1F1F1F] border border-[#747775] text-sm font-medium shadow-md hover:bg-gray-50 cursor-pointer" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        <span>Sign in with Google</span>
      <% end %>

      <%# Follows Meta's brand guidance for Facebook Login buttons. Hidden until FACEBOOK_APP_ID is set. %>
      <% if facebook_sign_in_enabled? %>
        <%= button_to "/auth/facebook", method: :post, form: { data: { turbo: false } },
              class: "inline-flex h-10 w-64 items-center justify-center gap-2.5 rounded-full pl-3 pr-4 bg-[#1877F2] text-white text-sm font-medium shadow-md hover:bg-[#166FE5] cursor-pointer" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#fff" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg>
          <span>Continue with Facebook</span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<%= link_to "Privacy · Quyền riêng tư", privacy_path,
      class: "fixed bottom-4 inset-x-0 mx-auto w-fit text-sm text-white/90 underline underline-offset-2 drop-shadow-[0_1px_4px_rgb(0_0_0/0.8)] hover:text-white" %>
