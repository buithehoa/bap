<% content_for :title, "Bap" %>

<div class="w-full max-w-xl">
  <h1 class="font-bold text-4xl">Bap</h1>

  <% if authenticated? %>
    <p class="mt-4 text-gray-700">Signed in as <%= Current.user.email_address %></p>
    <%= button_to "Sign out", session_path, method: :delete,
          class: "mt-6 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium cursor-pointer" %>
  <% else %>
    <p class="mt-4 text-gray-700">Rails <%= Rails.version %> on Ruby <%= RUBY_VERSION %>.</p>
    <%= link_to "Sign in", new_session_path,
          class: "mt-6 inline-block rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  <% end %>
</div>
