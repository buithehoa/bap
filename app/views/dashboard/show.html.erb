<% content_for :title, "Dashboard · Bap" %>

<div class="w-full max-w-xl">
  <%= render "shared/flash" %>

  <h1 class="font-bold text-3xl">Dashboard</h1>
  <p class="mt-4 text-gray-700">Signed in as <%= Current.user.email_address %></p>

  <%= button_to "Sign out", session_path, method: :delete,
        class: "mt-6 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-200 font-medium cursor-pointer" %>
</div>
