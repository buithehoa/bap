# syntax=docker/dockerfile:1
# Development image used by compose.yaml (the app source is bind-mounted at /rails).
# For the production image, see Dockerfile.

ARG RUBY_VERSION=4.0.10
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl git libjemalloc2 libpq-dev libvips libyaml-dev pkg-config postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle"

# Run as the host user's UID/GID so files written to the bind mount (tmp/, log/,
# app/assets/builds) stay editable on the host. bin/docker-dev passes these in.
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd --gid "$GROUP_ID" app && \
    useradd --uid "$USER_ID" --gid "$GROUP_ID" --create-home --shell /bin/bash app && \
    mkdir -p "$BUNDLE_PATH" && chown app:app "$BUNDLE_PATH" /rails
USER app

COPY --chown=app:app Gemfile Gemfile.lock ./
RUN bundle install

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
